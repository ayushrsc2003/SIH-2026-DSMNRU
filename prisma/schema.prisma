// Prisma schema for SIH 2026 Internal Round Portal (DSMNRU Lucknow)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id                   String   @id @default("config")
  isRegistrationActive Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model Team {
  id                    String   @id @default(cuid())
  teamId                String   @unique
  teamName              String
  domain                String   @default("General Innovation")
  problemStatementId    String   @default("SIH1721")
  problemStatementTitle String
  ideaSummary           String   @default("See attached PPT file")
  mentorName            String   @default("Assigned Faculty Mentor")
  mentorDept            String   @default("Computer Science & Engineering")
  pptUrl                String?  
  pptFileName           String?  
  googleDriveLink       String?  
  authDocxPath          String?  
  authPdfPath           String?  
  createdAt             DateTime @default(now())

  members Member[]
}

model Member {
  id           String  @id @default(cuid())
  teamId       String
  name         String
  branch       String  @default("B.Tech CSE")
  year         String  @default("4th Year")
  universityId String  @default("DSMNRU/2022/REG")
  gender       String
  email        String  @unique
  phone        String
  isLeader     Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}
